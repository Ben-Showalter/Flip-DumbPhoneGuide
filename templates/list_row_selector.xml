<?xml version="1.0" encoding="utf-8"?>
<!-- Use on a ListView:
       android:listSelector="@drawable/list_row_selector"
       android:drawSelectorOnTop="true"
     Swap #FFFF7A1A for your app accent color. -->
<!-- Drawn ON TOP of each row (see drawSelectorOnTop="true" on the ListViews
     that use this) as a translucent highlight overlay - this is the
     reliable way to show D-pad focus in a classic ListView, since the
     list positions this drawable at the selected item's bounds directly
     rather than depending on the row view's own state propagation. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#553D2A0F" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="#FFFF7A1A" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#553D2A0F" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="#FFFF7A1A" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#553D2A0F" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="#FFFF7A1A" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
