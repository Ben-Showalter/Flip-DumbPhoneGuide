<?xml version="1.0" encoding="utf-8"?>
<!-- Manifest pieces every flip-phone app should have. Copy what applies.
     See docs/platform.md and docs/layout-and-type.md for the reasons. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No touchscreen on these phones. Without this the app is
         "incompatible" for any store or filter that checks features. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Legacy storage: cap it, and only runtime-check it when SDK_INT <= P. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <application android:theme="@style/AppTheme">

        <!-- singleTask: a launch from a hardware key / home icon lands here,
             not on whatever screen was left on top.
             configChanges: opening/closing the flip or a keypad state change
             must NOT recreate the activity (it drops held keys and sockets). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout"
            android:windowSoftInputMode="stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Optional kiosk/lock: disabled HOME alias, enabled at runtime with
             setComponentEnabledSetting(..., DONT_KILL_APP) so Home/End return
             to the app. (Screen pinning's dialog is not D-pad reachable.) -->
        <activity-alias
            android:name=".HomeAlias"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

    </application>
</manifest>
